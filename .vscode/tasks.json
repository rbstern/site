{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Site: preview (serve)",
      "type": "shell",
      "command": "Rscript -e 'options(servr.daemon = FALSE); blogdown::serve_site(port = 4321, browser = FALSE)'",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "detail": "Equivalente ao Serve Site do RStudio. Abre em http://localhost:4321"
    },
    {
      "label": "Site: build (Hugo 0.97.0)",
      "type": "shell",
      "command": "Rscript -e 'blogdown::build_site(build_rmd = FALSE)'",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "detail": "Gera public/ do mesmo jeito que o Netlify."
    },
    {
      "label": "Site: build + knit dos .Rmd alterados",
      "type": "shell",
      "command": "Rscript -e 'blogdown::build_site(build_rmd = \"timestamp\")'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Reprocessa os .Rmd cujo fonte esta mais novo que o .html gerado."
    },
    {
      "label": "Site: parar servidor",
      "type": "shell",
      "command": "Rscript -e 'blogdown::stop_server()' || pkill -f 'hugo server'",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "detail": "Encerra o preview."
    }
  ]
}
